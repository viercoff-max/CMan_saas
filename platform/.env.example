# Copy is generated automatically by `npm run setup` (creates .env.local with random secrets).
# PRODUCTION: keep this file and DATA_DIR OUTSIDE OneDrive/Dropbox (see docs/RUNBOOK.md).
APP_SECRET=
ADMIN_EMAIL=
# Only needed for the first start (creates the admin). Delete it from .env.local after the first login.
ADMIN_PASSWORD=
TENANT_NAME=Chefman
# Must be a public HTTPS URL (tunnel such as ngrok/cloudflared) for real Meta/Shopify callbacks.
# When it starts with https:// the session cookie is marked Secure.
PUBLIC_URL=http://localhost:3000
# Client IP for rate limits and audit hashes (src/lib/security/client-ip.ts): comma-separated request headers set by
# YOUR proxy, checked in order. Empty = "x-forwarded-for,x-real-ip" (first hop), right for Vercel, which overwrites
# them. Behind a Cloudflare tunnel (on-prem): cf-connecting-ip. Never list a header your proxy does not overwrite.
TRUSTED_PROXY_HEADERS=

# Data backend: "sqlite" (default, local file under DATA_DIR) or "supabase" (needs NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SECRET_KEY below, and the migrations in supabase/migrations applied). It also picks file storage:
# sqlite -> DATA_DIR/uploads + DATA_DIR/brand-assets; supabase -> Storage buckets "tenant-files" / "brand-assets".
DATA_BACKEND=

# SQLite mode only: comma-separated emails of local users who are platform admins (all-tenants screen).
# Supabase mode ignores it: add the user id to public.platform_admins instead.
PLATFORM_ADMIN_EMAILS=

# Where the database, uploads and handoff outbox live. Default: ./data (inside the project folder).
# Production example (not synced): DATA_DIR=C:\ProgramData\SocialInbox\data
DATA_DIR=

# Retention (npm run purge, daily). Conversations: days to keep (minimum 30, default 90).
RETENTION_DAYS=90
# Safety/legal conversations are kept (legal hold) but their text is masked after this many days.
LEGAL_HOLD_MASK_DAYS=365
# Handoff e-mail files in DATA_DIR/outbox.
OUTBOX_RETENTION_DAYS=30

# Supabase (SaaS MVP). URL and publishable key are public; the secret key and DB URL are NOT (server only).
# SUPABASE_SECRET_KEY = the project's secret (service-role) key: it bypasses RLS and is used only by src/lib/data/supabase.
# Live data-layer test (never in `npm test`): RUN_LIVE=1 with these set, on a TEST project only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# AI (SaaS MVP): Claude Haiku via the official Anthropic SDK. Set a monthly spend limit in the Anthropic console.
# Default provider whenever ANTHROPIC_API_KEY is set (server only, never NEXT_PUBLIC_*).
# ANTHROPIC_MODEL is optional: empty = claude-haiku-5-5 (effort "low", adaptive thinking). Other ids are accepted,
# e.g. claude-haiku-4-5 (sent without effort/thinking).
# Per-tenant monthly token caps: tenants.ai_monthly_token_cap (Supabase default 300,000 for new tenants since
# migration 20261120010200; SQLite on-prem 2,000,000); at the cap the bot answers offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional: "anthropic" | "openai". Only needed to force OpenAI while both keys are set.
AI_PROVIDER=
# Platform-wide breaker: max AI tokens per UTC day across ALL tenants (input incl. cache + output). Empty = 5000000.
# 0 stops every paid AI call (the bot answers with the offline fallback / hands off). Counted in-process and in the
# shared rate_limits table (key engine-ai-day:YYYY-MM-DD, 1,000-token units reserved before each call).
PLATFORM_DAILY_TOKEN_CAP=
# Platform console cost estimate, USD per million tokens. Empty = Claude Haiku 5.5 list prices (0.10 in / 0.50 out).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# Legacy AI provider, used only when ANTHROPIC_API_KEY is empty (or AI_PROVIDER=openai). No key at all = offline replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Platform Meta app (OPTIONAL: businesses can connect WhatsApp with their OWN Meta app without these;
# see /api/webhooks/whatsapp/<id>). When set, /api/webhooks/meta requires META_APP_SECRET (unsigned requests are rejected).
# It is also used to verify Meta's data-deletion callback (signed_request).
META_VERIFY_TOKEN=
META_APP_SECRET=
# Leave EMPTY. "1" only for local testing without Meta; ignored when PUBLIC_URL is not localhost.
ALLOW_UNSIGNED_WEBHOOKS=

# Shopify one-button OAuth (optional; without it the form uses a manual token or the demo store).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Default read_orders. Add ",read_all_orders" only if Shopify approved it for the app.
SHOPIFY_SCOPES=read_orders
